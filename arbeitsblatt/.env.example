# Alle Werte sind Runtime-Variablen. Nichts davon gehört ins Repository oder in Build-Argumente.
# In Coolify: für Passwörter, SECRET_KEY, KI-Schlüssel und Archivschlüssel
# „Available at Buildtime“ AUS und „Available at Runtime“ AN.

# ── Flask / Lehrkraft ─────────────────────────────────────────────────────
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=BITTE-ERSETZEN
# Ohne gesetztes Passwort ist der Lehrerbereich gesperrt.
LEHRER_PASSWORD=BITTE-ERSETZEN
# Hinter HTTPS (Coolify) auf 1 setzen; lokal per HTTP auf 0 lassen.
SESSION_COOKIE_SECURE=0

# ── KI (optional) – ohne Schlüssel bleiben alle Aufgaben nutzbar ────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
DAILY_TOKEN_LIMIT=50000

# ── IServ-WebDAV-Archiv (optional, empfohlen) ───────────────────────────────
# Nur https://, ohne Zugangsdaten, Query oder Fragment.
ISERV_WEBDAV_URL=
ISERV_WEBDAV_USERNAME=
ISERV_WEBDAV_PASSWORD=
# Zielordner wird administrativ angelegt; die App legt ihn nicht selbst an.
ISERV_BACKUP_PATH=Files/Backups_AB_KI
# 32 Byte, URL-safe Base64:
# python -c "import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# Unabhängig von IServ sicher verwahren – ohne diesen Schlüssel sind Archive nicht lesbar.
ISERV_BACKUP_ENCRYPTION_KEY=
ISERV_TIMEOUT_SECONDS=15
# Optional: Pfad zu einer schulischen CA-Datei (PEM). TLS-Prüfung wird nie deaktiviert.
ISERV_CA_BUNDLE=

# ── Optional ───────────────────────────────────────────────────────────────
# DB_PATH=/app/data/honigbiene.db
# SOCKETIO_ASYNC_MODE=threading
